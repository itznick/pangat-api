# ── Required ────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://user:password@host:5432/pangat
# Random string, 32+ chars. The API refuses to start in production without it.
JWT_SECRET=
NODE_ENV=production

# ── Recommended ─────────────────────────────────────────────────────────────
# Comma-separated list of allowed web origins (CORS)
FRONTEND_URL=https://your-web-app.example.com
# Razorpay webhook signing secret. Without it the webhook endpoint answers 503 (it is never accepted unsigned).
RAZORPAY_WEBHOOK_SECRET=
# 16+ chars; lets you create the first platform admin via POST /auth/setup-super-admin (header x-bootstrap-secret)
PLATFORM_BOOTSTRAP_SECRET=
JWT_EXPIRATION=7d

# ── Optional ────────────────────────────────────────────────────────────────
# Set to false to skip automatic schema migrations on boot (then run src/migrations/*.sql yourself)
AUTO_MIGRATE=true
# Transactional email provider for password-reset mails (see common/services/email-delivery.service.ts)
# TEST ONLY - never set in production: THROTTLE_DISABLED=true

# ── Required ────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://user:password@host:5432/pangat
# Random string, 32+ chars. The API refuses to start in production without it.
JWT_SECRET=
NODE_ENV=production

# ── Recommended ─────────────────────────────────────────────────────────────
# Comma-separated list of allowed web origins (CORS)
FRONTEND_URL=https://your-web-app.example.com
# Razorpay webhook signing secret. Without it the webhook endpoint answers 503 (it is never accepted unsigned).
RAZORPAY_WEBHOOK_SECRET=
# 16+ chars; lets you create the first platform admin via POST /auth/setup-super-admin (header x-bootstrap-secret)
PLATFORM_BOOTSTRAP_SECRET=
JWT_EXPIRATION=7d

# ── Optional ────────────────────────────────────────────────────────────────
# Set to false to skip automatic schema migrations on boot (then run src/migrations/*.sql yourself)
AUTO_MIGRATE=true
# Transactional email (password resets, announcements, alerts and email OTP codes).
# Set ONE provider; with several, the first of smtp > brevo > resend > sendgrid wins (or force one with EMAIL_PROVIDER).
# Keys can also be saved from Super Admin > Settings > Email (stored encrypted), which overrides these.
#   Brevo   (free: 300 emails/day)  - verify a sender address, no domain needed
#   Resend  (free: 100 emails/day)  - needs a verified sending domain
# SMTP (free with most mailboxes). OTP_SMTP_HOST/PORT/USER/PASS and OTP_FROM_EMAIL are accepted as aliases.
#   Brevo: smtp-relay.brevo.com:587 | Gmail: smtp.gmail.com:587 with an App Password | Zoho: smtp.zoho.in:587
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
BREVO_API_KEY=
RESEND_API_KEY=
SENDGRID_API_KEY=
EMAIL_PROVIDER=
# Sender shown on every mail; must be a sender/domain verified with the provider
EMAIL_FROM=
# Number of proxies in front of the API (Render: 1). Decides which client IP is trusted for audit evidence and rate limiting.
TRUST_PROXY_HOPS=1
# Emergency: set to true to skip the platform-admin sign-in code if mail is down or the admin email is not a real inbox
ADMIN_LOGIN_OTP_DISABLED=false
# Email OTP is switched on from Super Admin > Settings > Security (admin sign-in code, sign-up email verification)
# TEST ONLY - never set in production: THROTTLE_DISABLED=true

# ── Platform control centre ─────────────────────────────────────────────────
# Key used to encrypt secrets stored from the Super Admin Settings screen (AES-256-GCM). Defaults to JWT_SECRET
# if unset; set it explicitly (32+ random chars) so rotating JWT_SECRET never makes stored secrets unreadable.
PLATFORM_SETTINGS_KEY=
# Set to true to switch off the in-process background jobs (health sampling, subscription expiry sweep, log retention)
JOBS_DISABLED=false

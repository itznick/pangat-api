    "test:pilot-payments": "node --test --test-concurrency=1 test/pilot-payment-integrity.e2e.test.mjs",
    "test:pilot-ops": "node --test --test-concurrency=1 test/pilot-ops.e2e.test.mjs",
    "test:pilot-menu": "node --test --test-concurrency=1 test/pilot-menu-import.e2e.test.mjs",
